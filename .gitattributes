# Normalise line endings so chunk offsets and test fixtures behave identically
# on every platform.
* text=auto eol=lf

*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.ico binary

# Keep example fixtures byte-stable across checkouts.
examples/input/** text eol=lf

# Exclude development-only paths from release archives.
tests/ export-ignore
.github/ export-ignore
.gitattributes export-ignore
.gitignore export-ignore
